#!/bin/bash
#
# One command per recording. Picks the filename, runs the health check, prints the
# protocol for the test you asked for, records, analyses, and backs up.
#
#   cast dad 20ft
#
# CAPTURE.md is the authority on why each step exists; this script is that document
# made executable so a session can be run without reading it again.

set -u
cd "$(dirname "$0")" || exit 1

COLLECT=./.build/debug/castr-collect
ANALYZE=./.build/debug/castr-analyze
SESSIONS=Sessions
BACKUP="$HOME/Documents/castr-sessions"
RATE=200
CHECK_SECONDS=5

bold=$(tput bold 2>/dev/null || true)
dim=$(tput dim 2>/dev/null || true)
red=$(tput setaf 1 2>/dev/null || true)
green=$(tput setaf 2 2>/dev/null || true)
yellow=$(tput setaf 3 2>/dev/null || true)
off=$(tput sgr0 2>/dev/null || true)

say()  { printf '%s\n' "$*"; }
head1() { printf '\n%s%s%s\n' "$bold" "$*" "$off"; }
warn() { printf '%s%s%s\n' "$yellow" "$*" "$off"; }
die()  { printf '%s%s%s\n' "$red" "$*" "$off" >&2; exit 1; }

# Normalises a name typed at a prompt: drops surrounding quotes and any
# whitespace, lowercases the rest.
#
# People type 'trace9' with the quotes, or paste a name with a trailing space,
# and neither is a different rod. Rejecting those was technically correct and
# practically useless — the point of validating is to keep filenames sane, not
# to make someone retype something that was already unambiguous.
clean_name() {
    printf '%s' "${1:-}" | tr -d "\"'" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]'
}

usage() {
    cat <<'EOF'
cast <person> <test>      record a session — health check, setup, poses, collect
  --no-calibrate          reuse today's poses instead of running them again
cast calibrate [person]   mount poses — start of session, per caster, after any remount
cast profile <person>     height, experience, rod — three typed answers, once per person
cast rod <name>           rod geometry for the tip projection — once per rod
cast check                health check only, no recording
cast list                 what has been recorded so far
cast protocol             the field card — what to type at every prompt

TESTS
  updown      Test 0 — reference motion, no tags. Do this first, once per person.
  noline      Test 1 — short sequences, no line
  20ft        Test 2 — 20 ft of line, real deliveries
  fish        Test 3 — natural fishing, progressive line
  falsecast   counted forward false casts, no tags
  tagged      two-person session, a second person tags every stroke

EXAMPLES
  cast nate updown
  cast dad 20ft
EOF
}

# ---------------------------------------------------------------- build

ensure_built() {
    local newest
    # Rebuild when any source is newer than the binary. Recording against a stale
    # build is the kind of thing you only notice a session later.
    newest=$(find Sources Package.swift -type f -newer "$COLLECT" 2>/dev/null | head -1)
    if [ ! -x "$COLLECT" ] || [ ! -x "$ANALYZE" ] || [ -n "$newest" ]; then
        say "${dim}Building…${off}"
        swift build || die "build failed — fix that before recording"
    fi
}

# ---------------------------------------------------------------- health check

run_check() {
    head1 "Health check"
    cat <<EOF
Put the sensor flat on a hard surface and take your hands off it.
This measures for 5 s and tells you whether it still reads the 1.000 g it must
at rest. Re-run it whenever the sensor is remounted or the rod changes.
EOF
    printf '\n%sPress Enter when it is still and untouched…%s' "$bold" "$off"
    read -r _

    "$COLLECT" --check --seconds "$CHECK_SECONDS"
    local status=$?

    if [ $status -ne 0 ]; then
        warn ""
        warn "Health check FAILED. Do not record against this — the session will look"
        warn "fine and won't be. Fix it (recalibrate in the WitMotion app, or hold the"
        warn "sensor still and retry) and run cast check again."
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------- pose capture

CALIB=calibration

# Mean gravity vector and stillness for a still-pose CSV, as:
#   samples meanAccX meanAccY meanAccZ |acc| gyroMeanDPS gyroPeakDPS
# Columns 3-5 are AccX/Y/Z(g) and 6-8 AsX/Y/Z(°/s) in the WitMotion layout.
#
# Optional args 2 and 3 restrict it to a range of data rows (1-based, header
# excluded), so the three still windows can be pulled out of one continuous
# recording without cutting the file up.
pose_stats() {
    awk -F, -v s="${2:-1}" -v e="${3:-0}" 'NR > 1 && NF > 8 {
        d = NR - 1
        if (d < s) next
        if (e > 0 && d > e) next
        n++; ax += $3; ay += $4; az += $5
        g = sqrt($6*$6 + $7*$7 + $8*$8); gs += g; if (g > gp) gp = g
    }
    END {
        if (n == 0) { print "0 0 0 0 0 0 0"; exit }
        ax /= n; ay /= n; az /= n
        printf "%d %.4f %.4f %.4f %.4f %.2f %.2f\n",
               n, ax, ay, az, sqrt(ax*ax + ay*ay + az*az), gs/n, gp
    }' "$1"
}

# Thresholds are StaticCheck's, deliberately. Two definitions of "still" in one
# project is how you end up trusting the wrong one.
STILL_FAIL_DPS=20
STILL_WARN_DPS=5
GRAV_FAIL_G=0.10
GRAV_WARN_G=0.03

# Data rows written so far, header excluded.
rows_now() {
    local r=0
    [ -e "$SEQ_FILE" ] && r=$(wc -l < "$SEQ_FILE" | tr -d ' ')
    [ "$r" -gt 1 ] && printf '%d' $(( r - 1 )) || printf '0'
}

# Runs one timed phase of the calibration sequence against the already-running
# recorder, counting in samples rather than wall clock so a BLE stall shows up
# as a longer hold rather than a silently short window.
# Sets PHASE_START and PHASE_END to the data rows it spanned.
phase() {
    local headline="$1" secs="$2" style="${3:-hold}"
    local begin; begin=$(rows_now)
    local target=$(( begin + RATE * secs ))
    local r

    while kill -0 "$SEQ_PID" 2>/dev/null; do
        r=$(rows_now)
        [ "$r" -ge "$target" ] && break
        local done_n=$(( r - begin )) span=$(( RATE * secs ))
        local filled=$(( done_n * 24 / span )) bar= i=0
        [ "$filled" -lt 0 ] && filled=0
        while [ $i -lt 24 ]; do
            [ $i -lt $filled ] && bar="$bar#" || bar="$bar."
            i=$(( i + 1 ))
        done
        if [ "$style" = move ]; then
            printf '\r\033[2K  %s%s%s  [%s]' "$yellow$bold" "$headline" "$off" "$bar"
        else
            printf '\r\033[2K  %s%s%s  [%s]  %ds' "$bold" "$headline" "$off" "$bar" \
                $(( (target - r + RATE - 1) / RATE ))
        fi
        sleep 0.2
    done

    PHASE_START=$(( begin + 1 ))
    PHASE_END=$(rows_now)
    printf '\r\033[2K  %s%s%s  done\n' "$dim" "$headline" "$off"
}

# Rod axis in the sensor's frame, from the two tip-at-sky holds.
#
# Mirrors CastrCore/MountCalibration.swift, which is the authority. It exists
# here so the verdict lands while the rod is still in your hand — the browser
# would otherwise be the first thing to tell you the axis is unusable, by which
# time you are indoors and the mount has moved.
#
# Stand the blank vertical and gravity runs along it, so the reading is the
# butt-to-tip direction outright. The pose is done twice and the axis is their
# mean; how far apart they came out is the error bar, and it is the only figure
# in this whole sequence that measures the axis by itself.
#
# Prints: spreadDeg ax ay az   (spreadDeg -1 means degenerate)
rod_axis() {
    awk -v ax=$1 -v ay=$2 -v az=$3 -v bx=$4 -v by=$5 -v bz=$6 'BEGIN{
        an = sqrt(ax*ax + ay*ay + az*az); bn = sqrt(bx*bx + by*by + bz*bz)
        if (an == 0 || bn == 0) { print "-1 0 0 0"; exit }
        ax /= an; ay /= an; az /= an
        bx /= bn; by /= bn; bz /= bn
        c = ax*bx + ay*by + az*bz; if (c > 1) c = 1; if (c < -1) c = -1
        mx = ax + bx; my = ay + by; mz = az + bz
        mn = sqrt(mx*mx + my*my + mz*mz)
        if (mn == 0) { print "-1 0 0 0"; exit }
        printf "%.2f %.6f %.6f %.6f\n",
               atan2(sqrt(1-c*c), c) * 57.29577951, mx/mn, my/mn, mz/mn
    }'
}

# How far a level hold sits off square to the axis. Reported, never gated on: it
# cannot tell its own tilt from the axis it is checking, which is exactly what
# made the previous version of this impossible to pass.
level_check() {
    awk -v ax=$1 -v ay=$2 -v az=$3 -v lx=$4 -v ly=$5 -v lz=$6 'BEGIN{
        an = sqrt(ax*ax + ay*ay + az*az); ln = sqrt(lx*lx + ly*ly + lz*lz)
        if (an == 0 || ln == 0) { print "-1"; exit }
        c = (ax*lx + ay*ly + az*lz) / (an*ln); if (c > 1) c = 1; if (c < -1) c = -1
        d = atan2(sqrt(1-c*c), c) * 57.29577951 - 90
        if (d < 0) d = -d
        printf "%.2f\n", d
    }'
}

# How far the two tip-at-sky holds may disagree before the capture is treated as
# not having been performed. MountCalibration.swift carries the same numbers and
# the reasoning: the pose repeated across whole sessions on 2026-08-11 held to
# 3-9°, so 20° means one hold was not vertical rather than merely imperfect.
AXIS_MAX_SPREAD=20
# Above this the level hold is called out, never refused.
LEVEL_WARN=20

# Angle between two gravity vectors, in degrees.
vec_angle() {
    awk -v ax=$1 -v ay=$2 -v az=$3 -v bx=$4 -v by=$5 -v bz=$6 'BEGIN{
        d = ax*bx + ay*by + az*bz
        m = sqrt(ax*ax+ay*ay+az*az) * sqrt(bx*bx+by*by+bz*bz)
        if (m == 0) { print "0"; exit }
        c = d/m; if (c > 1) c = 1; if (c < -1) c = -1
        printf "%.1f", atan2(sqrt(1-c*c), c) * 57.29577951
    }'
}

# A pose held in the hand can't meet the thresholds a sensor lying on a table
# can, and judging it by those would reject every valid capture. What actually
# corrupts a 5 s gravity average is sustained drift, not a momentary twitch, so
# these gate the gyro *mean* where StaticCheck gates the peak. Same quantity,
# different physical situation, stated rather than fudged.
HELD_WARN_DPS=5
HELD_FAIL_DPS=12

# Starts the recorder and proves data is flowing before any timed step begins,
# so a slow BLE connect can never eat into a hold window. Sets SEQ_FILE/SEQ_PID
# for phase() and rows_now(). Returns 1 with the recorder already cleaned up.
seq_start() {
    SEQ_FILE="$1"
    head1 "Step 0 — connection check"
    trap '' INT
    "$COLLECT" -o "$SEQ_FILE" --despike --rate "$RATE" --seconds 300 --no-tags \
        >/dev/null 2>&1 &
    SEQ_PID=$!

    local ticks=0 r=0
    while kill -0 "$SEQ_PID" 2>/dev/null; do
        r=$(rows_now)
        [ "$r" -gt $(( RATE / 2 )) ] && break
        printf '\r\033[2K  %sConnecting to the sensor…%s' "$dim" "$off"
        ticks=$(( ticks + 1 ))
        if [ "$ticks" -gt 150 ]; then break; fi
        sleep 0.2
    done
    printf '\r\033[2K'

    if [ "$(rows_now)" -le $(( RATE / 2 )) ]; then
        seq_stop
        warn "  Never connected. Check the sensor is on and charged, and that"
        warn "  Bluetooth is allowed for this terminal in System Settings."
        rm -f "$SEQ_FILE"
        return 1
    fi

    # Prove it is reading sensibly, not merely connected.
    set -- $(pose_stats "$SEQ_FILE")
    say "  ${green}Connected${off} — ${dim}$1 samples so far, reading $5 g${off}"
    if awk "BEGIN{exit !(($5 - 1.0) ^ 2 > $GRAV_FAIL_G ^ 2)}"; then
        seq_stop
        warn "  But it reads $5 g, not 1.000. Run cast check before going further."
        rm -f "$SEQ_FILE"
        return 1
    fi
    return 0
}

seq_stop() {
    kill -TERM "$SEQ_PID" 2>/dev/null
    wait "$SEQ_PID" 2>/dev/null
    trap - INT
    stty sane 2>/dev/null
}

calibrate_once() {
    # Who is holding the rod. The mount half of this sequence belongs to the
    # rod, but the two swings are shoulder rotations that belong to the person
    # doing them — CALIBRATION.md §2. So a calibration is stamped with a caster
    # and a second caster needs their own, even on the same rod the same day.
    local who="${1:-}"
    mkdir -p "$CALIB"
    local stamp; stamp=$(date '+%Y-%m-%d_%H-%M-%S')

    local seqfile="$CALIB/$stamp-sequence.csv"

    head1 "Mount calibration — one continuous capture, about 30 seconds"
    cat <<EOF

  ${dim}Three held positions with the swings between them. The script counts the
  time and tells you when to move — you never have to watch a clock.${off}

    1  arm straight up, rod tip at the sky     hold 5 s
    2  bring it down to point forward          the swing is measured too
    3  arm out in front, rod level             hold 5 s
    4  raise it back up to vertical
    5  arm straight up, rod tip at the sky     hold 5 s   ← the same pose again
EOF

    seq_start "$seqfile" || return 1

    say ""
    say "  ${dim}Read this out:${off}"
    say "    \"Raise the rod straight up, arm extended, tip at the sky."
    say "     Sight along the blank and get it properly vertical — this"
    say "     is the pose that measures the rod. Stay still until I tell"
    say "     you to move.\""
    say ""
    printf '  %sPress Enter when they are in position and still →%s ' "$bold" "$off"
    read -r _
    say ""

    phase "1  HOLD — arm straight up, tip at the sky" 5
    local a1=$PHASE_START a2=$PHASE_END

    phase "2  BRING IT DOWN TO POINT FORWARD" 3 move

    phase "3  HOLD — arm out in front, rod level" 5
    local b1=$PHASE_START b2=$PHASE_END

    phase "4  RAISE IT BACK UP TO VERTICAL" 3 move

    phase "5  HOLD — arm straight up, tip at the sky again" 5
    local c1=$PHASE_START c2=$PHASE_END

    seq_stop

    say ""
    say "  ${green}${bold}DONE — you can relax.${off}"

    # ---- the three still windows, pulled out of the one recording ----
    local verdict=ok
    # Poses 1 and 5 are the same tip-at-sky hold done twice; pose 3 is the level
    # one in between. d/c carry the two verticals, u the level hold.
    local dx dy dz ux uy uz cx cy cz
    local label
    for label in vertical-1 level vertical-2; do
        case $label in
        vertical-1) set -- $(pose_stats "$SEQ_FILE" "$a1" "$a2") ;;
        level)      set -- $(pose_stats "$SEQ_FILE" "$b1" "$b2") ;;
        vertical-2) set -- $(pose_stats "$SEQ_FILE" "$c1" "$c2") ;;
        esac
        POSE_N=$1; POSE_X=$2; POSE_Y=$3; POSE_Z=$4; POSE_MAG=$5; POSE_GMEAN=$6

        say ""
        say "  ${bold}$label${off}  ${dim}$POSE_N samples · gravity X $POSE_X Y $POSE_Y Z $POSE_Z · drift $POSE_GMEAN °/s${off}"

        if [ "$POSE_N" -lt $(( RATE * 3 )) ]; then
            warn "    too short — only $POSE_N samples, under 3 s"
            verdict=fail
        elif awk "BEGIN{exit !($POSE_GMEAN > $HELD_FAIL_DPS)}"; then
            warn "    moved too much during the hold ($POSE_GMEAN °/s)"
            verdict=fail
        elif awk "BEGIN{exit !($POSE_GMEAN > $HELD_WARN_DPS)}"; then
            warn "    some drift ($POSE_GMEAN °/s) — usable, steadier is better"
        fi

        case $label in
        vertical-1) dx=$POSE_X; dy=$POSE_Y; dz=$POSE_Z ;;
        level)      ux=$POSE_X; uy=$POSE_Y; uz=$POSE_Z ;;
        vertical-2) cx=$POSE_X; cy=$POSE_Y; cz=$POSE_Z ;;
        esac
    done

    # Geometry checks. Down and up point the rod along the same line in opposite
    # senses, so their gravity vectors should come back ~180° apart — that pair
    # is a consistency check, NOT a source of mount information, because two
    # antiparallel vectors constrain no more than one does. The forward hold is
    # the one that carries the clocking, being the only pose with gravity across
    # the rod rather than along it. See CALIBRATION.md §2.
    # The rod axis, from the two tip-at-sky holds. Their disagreement is the
    # error bar and it is the only figure here that measures the axis alone —
    # a level hold cannot separate its own tilt from the axis it is checking,
    # which is what made the old gate impossible to pass. CALIBRATION.md §2.
    local axspread axx axy axz axlevel
    set -- $(rod_axis $dx $dy $dz $cx $cy $cz)
    axspread=$1; axx=$2; axy=$3; axz=$4
    # Squareness of the level hold against that averaged axis: reported, never
    # gated on.
    axlevel=$(level_check $axx $axy $axz $ux $uy $uz)

    head1 "Geometry"
    say "  the two tip-at-sky holds are ${axspread}° apart   ${dim}this is the measurement${off}"
    say "  level hold sits ${axlevel}° off square              ${dim}sanity only, not a gate${off}"

    local axis_ok=1 axerr
    axerr=$(awk "BEGIN{printf \"%.2f\", $axspread / 2}")
    if awk "BEGIN{exit !($axspread < 0 || $axspread > $AXIS_MAX_SPREAD)}"; then
        axis_ok=0
        warn ""
        warn "  Rod axis: NO — the two tip-at-sky holds are ${axspread}° apart,"
        warn "  over the ${AXIS_MAX_SPREAD}° limit. One of them was not vertical."
        warn "  This session will get a swing path but no rod tip path."
        warn "  Redo it: sight along the blank both times and get it truly upright."
    else
        say ""
        say "  ${green}Rod axis: ok${off}  ${dim}±${axerr}° — the two holds agree that closely${off}"
    fi

    if awk "BEGIN{exit !($axlevel > $LEVEL_WARN)}"; then
        warn ""
        warn "  The level hold is ${axlevel}° off square to the rod. That is a smell,"
        warn "  not a failure — it cannot tell its own tilt from the axis, so it"
        warn "  does not touch the verdict above. Worth a steadier hold next time."
    fi

    cat > "$CALIB/$stamp.json" <<EOF
{
  "captured": "$stamp",
  "caster": $([ -n "$who" ] && printf '"%s"' "$who" || printf 'null'),
  "verdict": "$verdict",
  "sequenceCsv": "$(basename "$SEQ_FILE")",
  "holds": {
    "vertical": [
      { "rows": [$a1, $a2], "meanAcc": [$dx, $dy, $dz] },
      { "rows": [$c1, $c2], "meanAcc": [$cx, $cy, $cz] }
    ],
    "level": [
      { "rows": [$b1, $b2], "meanAcc": [$ux, $uy, $uz] }
    ]
  },
  "swings": { "downToLevelRows": [$a2, $b1], "backUpRows": [$b2, $c1] },
  "anglesDeg": { "verticalSpread": $axspread, "levelOffSquare": $axlevel },
  "rodAxis": {
    "ok": $([ "$axis_ok" -eq 1 ] && printf 'true' || printf 'false'),
    "axisBody": [$axx, $axy, $axz],
    "errorDeg": $axerr,
    "spreadDeg": $axspread,
    "maxSpreadDeg": $AXIS_MAX_SPREAD,
    "levelOffSquareDeg": $axlevel
  },
  "solved": false,
  "note": "Hold vectors and swing spans. rodAxis is solved here and is the butt-to-tip direction in the sensor's frame, averaged from the two tip-at-sky holds; errorDeg is half their disagreement and is the only figure here that measures the axis alone. levelOffSquareDeg is reported and never gated on — a level hold cannot tell its own tilt from the axis it is checking. Clocking is still not implemented (CALIBRATION.md §2); the level hold is the pose that can fix it. 'solved' refers to that, not to rodAxis."
}
EOF

    if [ "$verdict" = fail ]; then
        warn ""
        warn "  Calibration not saved as current. Run cast calibrate again."
        return 1
    fi

    ln -sf "$stamp.json" "$CALIB/current.json"
    # A per-caster pointer as well: the gate before a recording asks "has this
    # person been calibrated today", not "has anyone".
    [ -n "$who" ] && ln -sf "$stamp.json" "$CALIB/current-$who.json"
    head1 "Done"
    say "  ${green}$CALIB/$stamp.json${off}"
    say "  ${dim}whole sequence kept as $(basename "$SEQ_FILE")${off}"

    # The swings are the only arm measurement there is, and fitting them is the
    # browser's job — the lever-arm solve lives in reconstruct.js and has no
    # Swift counterpart on purpose (CLAUDE.md). So point at the file rather than
    # printing a number this script cannot honestly produce.
    say ""
    say "  ${bold}Arm:${off} drop ${dim}$CALIB/$(basename "$SEQ_FILE")${off} into the analyser"
    say "  ${dim}like any session — the swings fit a shoulder-to-sensor radius and it${off}"
    say "  ${dim}shows in the burst table. Their row spans are in the JSON under swings.${off}"

    # Only meaningful standalone; inside a recording the flow carries straight on.
    if [ "${IN_SESSION:-0}" -eq 0 ]; then
        say ""
        say "  Now record:  ${bold}cast <person> <test>${off}"
    fi
    return 0
}

# A hold can only be retried by redoing the sequence — it is one continuous
# recording, so there is no way to splice a replacement window into the middle.
run_calibrate() {
    local who="${1:-}"
    while true; do
        calibrate_once "$who" && return 0
        say ""
        printf '  %s[Enter]%s run it again   %s[q]%s give up  > ' \
            "$bold" "$off" "$bold" "$off"
        # A failed `read` means EOF — piped input or Ctrl-D. Without this the
        # loop would spin forever on an empty answer it can never satisfy.
        read -r answer || return 1
        case "$answer" in
        q|Q) return 1 ;;
        esac
    done
}

# Returns 1 rather than dying, for the same reason run_rod does: it runs inside
# a session as well as standalone.
run_profile() {
    local person; person=$(clean_name "${1:-}")
    if [ -z "$person" ]; then
        warn "  Which person? e.g. cast profile dad"
        return 1
    fi
    case "$person" in
    *[!a-z0-9]*)
        warn "  Names are lowercase letters and digits only — got '$person'."
        return 1 ;;
    esac

    mkdir -p "$CALIB"
    local prof="$CALIB/profile-$person.json"

    head1 "Profile — $person"
    say "${dim}Once per person, not per session. Typed answers only — the motion${off}"
    say "${dim}capture that used to live here is the calibration sequence's job now.${off}"
    say "${dim}See CALIBRATION.md §3.${off}"

    say ""
    printf 'Height (e.g. 5ft10 or 178cm), Enter to skip: '
    read -r height
    printf 'Casting experience (beginner / occasional / experienced): '
    read -r experience
    printf 'Rod (make, length, weight, action if known): '
    read -r rod

    cat > "$prof" <<EOF
{
  "person": "$person",
  "updated": "$(date '+%Y-%m-%d')",
  "height": "$height",
  "castingExperience": "$experience",
  "rod": "$rod",
  "note": "Typed inputs only. The shoulder sweep that used to be captured here is gone: cast calibrate's steps 2 and 4 are the same single-joint shoulder rotations at the same radius, so capturing it twice measured one thing two ways. Its row spans are in the calibration JSON under swings. Caveat carried over from CALIBRATION.md §2 — those swings belong to whoever held the rod during calibration, so in a session where one person calibrates and another casts, this profile has no arm measurement of its own. Anthropometric height derivation is still deliberately not computed — CALIBRATION.md §3 and §5.2."
}
EOF

    head1 "Done"
    say "  ${green}$prof${off}"
    say "  ${dim}arm rotations come from cast calibrate — run that at the start of the session${off}"
    return 0
}

# ---------------------------------------------------------------- rod

# Escapes a string for embedding in JSON. Rod labels contain the inch mark by
# nature — 9'0" — and an unescaped one produces a file nothing can read.
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Length in centimetres from a written measurement. Rods are sold in feet and
# inches, the geometry needs centimetres, so both are taken — but a bare number
# is refused rather than guessed at, because 9 and 274 are the same rod and only
# one of them is a plausible centimetre count.
to_cm() {
    printf '%s' "$1" | awk '
    {
        s = tolower($0); gsub(/[ \t]/, "", s)
        if (s ~ /^[0-9]+(\.[0-9]+)?cm$/)      { sub(/cm$/, "", s); printf "%.2f\n", s + 0; exit 0 }
        if (s ~ /^[0-9]+(\.[0-9]+)?(in|")$/)  { sub(/(in|")$/, "", s); printf "%.2f\n", (s + 0) * 2.54; exit 0 }
        if (s ~ /^[0-9]+(ft|\047)([0-9]+(\.[0-9]+)?)?(in|")?$/) {
            p = index(s, "ft"); flen = 2
            if (p == 0) { p = index(s, "\047"); flen = 1 }
            ft = substr(s, 1, p - 1) + 0
            rest = substr(s, p + flen)
            sub(/(in|")$/, "", rest)
            printf "%.2f\n", (ft * 12 + (rest == "" ? 0 : rest + 0)) * 2.54
            exit 0
        }
        exit 1
    }'
}

# Where the sensor sits, butt cap to the middle of the housing. Standardised at
# 8 inches rather than measured per rod, because CAPTURE.md already demands the
# same spot every time and a fixed number is easier to mount to than a recorded
# one — you can put the tape on the blank once and stop thinking about it.
#
# It is a scale term on the tip distance and nothing else: 2 cm of error on a
# 9 ft rod is 0.8% of the tip's radius, which is nothing beside the axis error
# in ROD-TIP.md §2.5. What would matter is mounting somewhere else and still
# claiming 8 inches, and that is a discipline problem, not a maths one.
SENSOR_OFFSET_STANDARD_CM=20.32       # 8 in

ask_length() {
    # $1 prompt, $2 variable name to set. Loops until it parses or is skipped.
    local prompt="$1" __var="$2" raw cm
    while true; do
        printf '%s' "$prompt"
        read -r raw
        if [ -z "$raw" ]; then eval "$__var=" ; return 0; fi
        if cm=$(to_cm "$raw"); then eval "$__var=\$cm"; return 0; fi
        warn "  Didn't understand '$raw'. Try 9ft, 9ft6, 9'6\", 274cm or 108in."
    done
}

# Returns 1 rather than dying on bad input. This is called mid-session as well
# as standalone, and exiting there would abandon a recording that has already
# passed its health check because someone mistyped a rod name.
run_rod() {
    local name; name=$(clean_name "${1:-}")
    if [ -z "$name" ]; then
        warn "  Which rod? A short name with the length in it, e.g. trace9"
        return 1
    fi
    case "$name" in
    *[!a-z0-9]*)
        warn "  Rod names are lowercase letters and digits only — got '$name'."
        warn "  Try trace9 or clearwater86: model and length, no spaces or dashes."
        return 1 ;;
    esac

    mkdir -p "$CALIB"
    local file="$CALIB/rod-$name.json"

    head1 "Rod — $name"
    say "${dim}Once per rod, not per session. The tip projection needs one tape${off}"
    say "${dim}measurement — the rod's length. The mount offset is standardised at${off}"
    say "${dim}8 in, so take the default unless this rod can't take it. See ROD-TIP.md.${off}"

    say ""
    printf 'Make, model, length, line weight (free text): '
    local label; read -r label

    say ""
    say "  ${dim}Measure along the blank with the rod assembled.${off}"
    local len_cm mount_cm
    ask_length "Rod length, butt cap to tip (9ft / 274cm), Enter to skip: " len_cm

    say ""
    say "  ${dim}The mount is standardised at 8 in from the butt cap to the middle of${off}"
    say "  ${dim}the housing. Mount it there and take the default; give a number only${off}"
    say "  ${dim}if this rod genuinely cannot take the sensor at 8 in.${off}"
    ask_length "Butt cap to sensor [Enter for 8in]: " mount_cm
    local mount_src=measured
    if [ -z "$mount_cm" ]; then
        mount_cm=$SENSOR_OFFSET_STANDARD_CM
        mount_src=standard
        say "  ${dim}using the 8 in standard — $mount_cm cm${off}"
    fi

    # A rod file is one *physical* rod, not a model. The same model comes in
    # several lengths and they are different levers — 9ft and 8ft6 differ by
    # 15 cm at the tip — so silently rewriting an existing rod's length would
    # leave every session already recorded against it quietly mis-scaled.
    if [ -e "$file" ] && [ -n "$len_cm" ]; then
        local was; was=$(sed -n 's/.*"rodLengthCm"[[:space:]]*:[[:space:]]*\([0-9.]*\).*/\1/p' "$file")
        if [ -n "$was" ] && awk "BEGIN{exit !(($was - $len_cm)^2 > 0.25)}"; then
            warn ""
            warn "  $file already exists at $was cm, and you have entered $len_cm cm."
            warn "  If these are two different rods, give the second one its own name"
            warn "  — trace9 and trace86, say. Overwriting rescales the tip path of"
            warn "  every session already recorded against this one."
            say ""
            printf '  %s[o]%s overwrite   %s[Enter]%s stop and pick another name  > ' \
                "$bold" "$off" "$bold" "$off"
            read -r answer
            case "$answer" in
            o|O) warn "  Overwriting." ;;
            *)   say "  Nothing saved."; return 1 ;;
            esac
        fi
    fi

    # The number the projection actually consumes. Left blank unless both parts
    # are known — a tip distance derived from one measurement and a guess is
    # worse than no tip path, because nothing downstream could tell.
    local tip="null"
    if [ -n "$len_cm" ] && [ -n "$mount_cm" ]; then
        tip=$(awk "BEGIN{printf \"%.2f\", $len_cm - $mount_cm}")
        if awk "BEGIN{exit !($tip <= 0)}"; then
            warn ""
            warn "  The sensor can't sit further up the blank than the rod is long."
            warn "  Nothing saved. Check both measurements and run this again."
            return 1
        fi
    fi

    cat > "$file" <<EOF
{
  "rod": "$name",
  "updated": "$(date '+%Y-%m-%d')",
  "label": "$(json_escape "$label")",
  "geometry": {
    "rodLengthCm": ${len_cm:-null},
    "sensorOffsetCm": ${mount_cm:-null},
    "sensorOffsetSource": "$mount_src",
    "tipFromSensorCm": $tip
  },
  "bench": {
    "ipGrains": null,
    "actionAngleDeg": null,
    "ccfCpm": null,
    "addedTipMassGrains": null,
    "dampingRatio": null,
    "testedOn": null
  },
  "note": "Geometry feeds the rod tip projection. sensorOffsetSource says whether the mount offset was measured on this rod or taken from the 8 in standard — the standard is an instruction to mount there, not an observation that you did. The bench block is the CCS static and dynamic tests (ROD-TIP.md §4) and stays blank until they are run — a class default must never be written here as though it were measured."
}
EOF

    ln -sf "rod-$name.json" "$CALIB/current-rod.json"

    head1 "Done"
    say "  ${green}$file${off}"
    if [ "$tip" = "null" ]; then
        say ""
        warn "  No tip distance — the browser analyser will not draw a tip path."
        say "  ${dim}Both measurements are needed. Run cast rod $name again to add them.${off}"
    else
        say "  ${dim}sensor sits $tip cm from the tip${off}"
    fi
    return 0
}

# Reads a JSON array like [1, 2, 3] out of a file by key.
json_array() {
    sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\(\[[^]]*\]\).*/\1/p" "$1" | head -1
}

# Reads one number or string out of a rod file. Small enough not to want a JSON
# parser, and the files are written by this script so the shape is known.
rod_field() {
    sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^,\"}]*\)\"\{0,1\}.*/\1/p" "$1" | head -1
}

# Which rod is on the end of the line, asked once per recording.
#
# The rod is a property of the session, not of the app: the same model comes in
# several lengths, they are different levers, and which one was in your hand is
# unrecoverable a week later. So it is chosen here and copied into the session
# sidecar rather than left to a pointer that whatever ran last happened to set.
#
# Sets ROD_NAME, ROD_LABEL, ROD_LENGTH_CM, ROD_OFFSET_CM, ROD_TIP_CM.
choose_rod() {
    ROD_NAME=""; ROD_LABEL=""; ROD_LENGTH_CM=""; ROD_OFFSET_CM=""; ROD_TIP_CM=""

    local rods=() f
    for f in "$CALIB"/rod-*.json; do [ -e "$f" ] && rods+=("$f"); done

    if [ "${#rods[@]}" -eq 0 ]; then
        warn ""
        warn "No rod set up yet. Sessions record fine without one, but nothing can"
        warn "draw a rod tip path until a rod is measured once."
        printf '%s[r]%s set one up now   %s[Enter]%s carry on without it  > ' \
            "$bold" "$off" "$bold" "$off"
        local answer; read -r answer
        case "$answer" in
        r|R) local rodname retry
             while true; do
                 printf 'Short name for this rod, length included (e.g. trace9): '
                 read -r rodname
                 run_rod "$rodname" && break
                 say ""
                 printf '  %s[Enter]%s try again   %s[s]%s carry on without a rod  > ' \
                     "$bold" "$off" "$bold" "$off"
                 read -r retry
                 case "$retry" in
                 s|S) warn "  Carrying on. No tip path from this session."; return 0 ;;
                 esac
             done
             rods=("$CALIB/rod-$(clean_name "$rodname").json") ;;
        *)   warn "  Carrying on. No tip path from this session."; return 0 ;;
        esac
    fi

    local pick="${rods[0]}"
    if [ "${#rods[@]}" -gt 1 ]; then
        # More than one rod on the shelf, so it has to be said out loud. Two
        # lengths of the same model are the failure this exists to prevent.
        head1 "Which rod?"
        local i=1
        for f in "${rods[@]}"; do
            printf '  %s%d%s  %-14s %s cm\n' "$bold" "$i" "$off" \
                "$(basename "$f" .json | sed 's/^rod-//')" \
                "$(rod_field "$f" rodLengthCm)"
            i=$(( i + 1 ))
        done
        say ""
        # Re-asks rather than exiting. Mid-session is the wrong place to be
        # strict about a keystroke.
        local n
        while true; do
            printf '  %s[1-%d]%s  > ' "$bold" "${#rods[@]}" "$off"
            read -r n
            n=$(printf '%s' "$n" | tr -d '[:space:]')
            case "$n" in
            ''|*[!0-9]*) warn "  A number from the list, please." ; continue ;;
            esac
            if [ "$n" -ge 1 ] && [ "$n" -le "${#rods[@]}" ]; then break; fi
            warn "  There is no rod $n on that list."
        done
        pick="${rods[$(( n - 1 ))]}"
    fi

    ROD_NAME=$(basename "$pick" .json | sed 's/^rod-//')
    ROD_LABEL=$(rod_field "$pick" label)
    ROD_LENGTH_CM=$(rod_field "$pick" rodLengthCm)
    ROD_OFFSET_CM=$(rod_field "$pick" sensorOffsetCm)
    ROD_TIP_CM=$(rod_field "$pick" tipFromSensorCm)
    ln -sf "$(basename "$pick")" "$CALIB/current-rod.json"

    say ""
    # A rod file with no length is the quiet way to lose a tip path: everything
    # else about the session works, and the projection is simply absent when you
    # get back. Offer the tape measure now, while the rod is in your hand.
    if [ -z "$ROD_TIP_CM" ] || [ "$ROD_TIP_CM" = null ]; then
        warn "Rod: $ROD_NAME — no rod length recorded, so this session gets no tip path."
        printf '  %s[Enter]%s add it now   %s[s]%s carry on without a tip path  > ' \
            "$bold" "$off" "$bold" "$off"
        local answer; read -r answer
        case "$answer" in
        s|S) warn "  Carrying on. No tip path from this session." ;;
        *)   if run_rod "$ROD_NAME"; then
                 pick="$CALIB/rod-$ROD_NAME.json"
                 ROD_LABEL=$(rod_field "$pick" label)
                 ROD_LENGTH_CM=$(rod_field "$pick" rodLengthCm)
                 ROD_OFFSET_CM=$(rod_field "$pick" sensorOffsetCm)
                 ROD_TIP_CM=$(rod_field "$pick" tipFromSensorCm)
             fi ;;
        esac
    fi

    if [ -n "$ROD_TIP_CM" ] && [ "$ROD_TIP_CM" != null ]; then
        say "${dim}Rod: $ROD_NAME · $ROD_LENGTH_CM cm, tip $ROD_TIP_CM cm from the sensor.${off}"
    fi
    return 0
}

# ---------------------------------------------------------------- protocol cards

protocol_for() {
    case "$1" in
    updown) cat <<'EOF'
  1  Rod horizontal, pointing forward. Hold COMPLETELY STILL 5 s.
  2  Block A — 10 slow cycles. Up, pause ~1 s, down, pause ~1 s. Always start UP.
     Count them out loud.
  3  Hold COMPLETELY STILL 5 s.
  4  Block B — 10 fast cycles. Same motion, brisk, NO pause at either end.
  5  Hold COMPLETELY STILL 5 s.

  Stay in one vertical plane — the value of this recording is that it is single-axis.
  Expect 40 strokes, signs strictly alternating. Anything else is a finding.
EOF
        ;;
    noline) cat <<'EOF'
  1  Hold COMPLETELY STILL 5 s
  2  Lift the rod back (pickup)
  3  3–5 false casts
  4  Final forward stroke — press 4
  5  Hold COMPLETELY STILL 5 s
  6  Repeat from 2, three or four times
  7  Then ONE sequence that just stops — false cast, then quit, no final stroke.
     Don't tag it.

  The still periods matter as much as the casting: they mark burst boundaries.
EOF
        ;;
    20ft) cat <<'EOF'
  Same structure as noline, with real deliveries — let the line shoot and land.

  1  Hold COMPLETELY STILL 5 s
  2  Pickup, 3–5 false casts, delivery — press 4
  3  Let the line land, then hold STILL 5 s   (that's the follow-through window)
  4  Repeat three or four times
  5  Include one deliberate non-delivery stop, untagged
EOF
        ;;
    fish) cat <<'EOF'
  Fish the way you actually would. Start ~15 ft, work line out as you go.
  Press 4 on each delivery, nothing else.

  Afterwards note the rough start and end line length — burst order then becomes
  a proxy for line length.
EOF
        ;;
    falsecast) cat <<'EOF'
  Counted forward false casts — 10 is the usual set. Pickup, then false cast,
  then stop. No delivery, no tagging.

  Expect 21 strokes: 10 forward, 10 back, plus the pickup.
EOF
        ;;
    tagged) cat <<'EOF'
  TWO PEOPLE. One casts, one tags every stroke as it finishes:

      1 pickup     2 false back     3 false forward     4 delivery

  The tagger watches the caster, not the screen. Late presses are fine and
  corrected for. One good 2–3 minute session beats several sloppy ones — this is
  the validation set for the whole classifier and it cannot be done alone.
EOF
        ;;
    esac
}

# ---------------------------------------------------------------- subcommands

case "${1:-}" in
-h|--help|help|"") usage; exit 0 ;;
protocol)
    # Short by default and printed straight to the screen: a card you have to
    # page through is a card you can't read while holding a rod. The long form
    # is one word away.
    case "${2:-}" in
    full|-a|--all)
        if [ -t 1 ] && command -v less >/dev/null 2>&1; then
            less -R PROTOCOL.md
        else
            cat PROTOCOL.md
        fi
        ;;
    *)
        cat <<EOF

${bold}CASTR — QUICK CARD${off}

  ${bold}cast <person> <test>${off}   — that is the whole thing.

  It runs what it needs and skips what is done: profile (first time for a
  person), rod (asked every session), calibration (first recording of the day
  ${bold}for that caster${off}), then the recording. Each is also its own
  command for redoing one alone:
  cast profile <person> · cast rod <name> · cast calibrate [person]

${bold}MOUNT${off}  ${bold}8 in from the butt cap${off}, above the cork — same spot, same rotation,
       every time. Nothing in the software can check this for you, and the rod
       tip projection assumes the 8 in.

${bold}CALIBRATE${off}  one 30 s sequence, all held in the hand. It checks the
           connection first, then counts you through. Just follow the screen.
  1  arm straight up, rod tip at the sky     hold 5 s
  2  bring it down to point forward           (the swing is measured too)
  3  arm out in front, rod level             hold 5 s
  4  raise it back up to vertical
  5  arm straight up, tip at the sky AGAIN   hold 5 s
     ${dim}1 and 5 are the same pose — how closely they agree is the
     measurement, so sight along the blank both times.${off}

${bold}RECORD${off}  cast dad 20ft
  tests   updown | noline | 20ft | fish | falsecast | tagged
          new person → ${bold}updown first${off}

  prompts you'll hit
    still and untouched…    sensor flat on a table, hands off, Enter (5 s)
    [c] calibrate now       c
    Press Enter to connect  then WAIT for ${bold}▶ GO${off} before casting
    ${bold}Ctrl-C${off}                  when the session is done
    >                       one-line note (rod, wind, anything odd), or Enter

  while casting
    ${bold}1${off} pickup   ${bold}2${off} false back   ${bold}3${off} false forward   ${bold}4${off} delivery
    press as each stroke finishes — late is fine
    watch that ${bold}rejected stays 0${off}

${dim}  cast protocol full    everything, including what each failure means${off}
${dim}                        (that one opens a pager — press q to leave it)${off}

EOF
        ;;
    esac
    exit 0
    ;;
check)     ensure_built; run_check; exit $? ;;
calibrate) ensure_built; run_calibrate "$(clean_name "${2:-}")"; exit $? ;;
profile)   run_profile "${2:-}"; exit $? ;;   # typed answers only — nothing to build
rod)       run_rod "${2:-}"; exit $? ;;
list)
    head1 "Recorded sessions"
    ls -lh "$SESSIONS"/*.csv 2>/dev/null | grep -v '\.events\.csv' \
        | awk '{n = $9; sub(/^.*\//, "", n); printf "  %-28s %8s  %s %s\n", n, $5, $6, $7}' \
        || say "  none yet"
    exit 0
    ;;
esac

# ---------------------------------------------------------------- arguments

# Calibration runs without asking, because a prompt you answer the same way
# every time is not a choice. Skipping it stays possible for the case it exists
# for — the mount has not moved since a calibration earlier today — but it is a
# flag you have to mean, not a keystroke you can fumble mid-flow.
SKIP_CALIB=0
ARGS=()
for a in "$@"; do
    case "$a" in
    --no-calibrate|--skip-calibration) SKIP_CALIB=1 ;;
    *) ARGS+=("$a") ;;
    esac
done
set -- ${ARGS+"${ARGS[@]}"}

PERSON=$(clean_name "${1:-}")
TEST=$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')

[ -n "$TEST" ] || { usage; die "need both a person and a test"; }

case "$PERSON" in
*[!a-z0-9]*) die "person must be lowercase letters and digits only — got '$PERSON'" ;;
esac

case "$TEST" in
updown|noline|20ft|fish|falsecast|tagged) ;;
*) usage; die "unknown test '$TEST'" ;;
esac

# CAPTURE.md: the four casting labels don't apply to a counted reference motion,
# so those two record with tagging off.
TAGS=on
case "$TEST" in
updown|falsecast) TAGS=off ;;
esac

# Never overwrite. A recording cannot be reproduced, so a second attempt gets a
# suffix rather than the benefit of the doubt.
mkdir -p "$SESSIONS"
NAME="$PERSON-$TEST"
if [ -e "$SESSIONS/$NAME.csv" ]; then
    n=2
    while [ -e "$SESSIONS/$NAME-$n.csv" ]; do n=$((n + 1)); done
    warn "$NAME.csv already exists — recording as $NAME-$n.csv instead."
    NAME="$NAME-$n"
fi
CSV="$SESSIONS/$NAME.csv"
# castr-collect derives the tag sidecar from the CSV path, so it lands here too.
EVENTS="$SESSIONS/$NAME.events.csv"

# ---------------------------------------------------------------- run

ensure_built

head1 "Session: $PERSON — $TEST  →  $CSV"

cat <<EOF
Mount the sensor on the rod immediately above the cork handle, in the SAME spot
and the SAME rotational orientation as every other session. Same face up.
EOF

run_check || exit 1

# ---- setup, in the order it happens with a rod in your hand ----
#
# The health check above wanted the rod on the ground. Everything from here is
# with it picked up, so the order is: pick it up, answer the questions, then one
# Enter runs the whole pose sequence without stopping again.
IN_SESSION=1

head1 "Pick up the rod"
say "  ${dim}Leave the sensor exactly where it is. Nothing else touches the mount${off}"
say "  ${dim}from here until the session is done.${off}"

# Per person, ever. Three typed answers; it exists so a stroke can be read
# against the body that made it.
if [ ! -e "$CALIB/profile-$PERSON.json" ]; then
    warn ""
    warn "No profile for $PERSON — doing that first."
    run_profile "$PERSON" || die "profile not saved"
fi

# Which rod, every session. Not a pointer left over from last time — see
# choose_rod.
choose_rod

# Mount poses are per-session, per-remount, and per-caster. Today's are the ones
# that describe today's mount; anything older is treated as absent rather than as
# good enough. And a calibration belongs to whoever performed it — its two swings
# are their shoulder rotations — so a second caster needs their own even on the
# same rod the same day. current-<person>.json is only repointed on a passing
# calibration, so testing it is also what stops a failed pose pair satisfying the
# gate.
if [ -e "$CALIB/current-$PERSON.json" ] \
   && case "$(readlink "$CALIB/current-$PERSON.json")" in "$(date '+%Y-%m-%d')"_*) true ;; *) false ;; esac; then
    say ""
    say "${dim}Mount poses captured today for $PERSON — ok.${off}"
elif [ "$SKIP_CALIB" -eq 1 ]; then
    warn ""
    warn "Skipping calibration (--no-calibrate). No rod tip path from this"
    warn "session, and it cannot be re-referenced later."
else
    say ""
    if [ -e "$CALIB/current.json" ] \
       && case "$(readlink "$CALIB/current.json")" in "$(date '+%Y-%m-%d')"_*) true ;; *) false ;; esac; then
        say "${dim}There is a calibration from today, but not one $PERSON did. The mount${off}"
        say "${dim}half would carry over; the two swings would not — they are shoulder${off}"
        say "${dim}rotations and they belong to whoever performed them.${off}"
    fi
    run_calibrate "$PERSON" || die "calibration failed — fix it, or re-run with --no-calibrate"
fi

head1 "What to do"
protocol_for "$TEST"

if [ "$TAGS" = on ]; then
    say ""
    say "  ${bold}Tag as each stroke finishes:${off}  1 pickup   2 false back   3 false forward   4 delivery"
    say "  ${dim}Don't press anything until it says it's recording.${off}"
fi

say ""
say "${bold}Press Enter to start collecting. Wait for the GO before you cast.${off}"
read -r _

TAGFLAG=""
[ "$TAGS" = off ] && TAGFLAG="--no-tags"

# castr-collect has to scan and connect before a single sample lands, and until
# now nothing said when that finished — you could start casting into a file that
# had not begun. This watcher polls the CSV from the background and calls the
# start, while the recorder itself stays in the foreground where it needs to be:
# KeyTagger reads stdin for the tag keys, and a backgrounded reader would take
# SIGTTIN and stop.
(
    waited=0
    while [ $waited -lt 300 ]; do
        if [ -e "$CSV" ] && [ "$(wc -l < "$CSV" | tr -d ' ')" -gt 20 ]; then
            printf '\r\033[2K\a\n  %s▶  GO — START CASTING%s\n\n' "$green$bold" "$off"
            exit 0
        fi
        printf '\r\033[2K  %sConnecting…%s' "$dim" "$off"
        waited=$(( waited + 1 ))
        sleep 0.2
    done
    printf '\r\033[2K  %sStill not connected after 60 s — check the sensor.%s\n' "$yellow" "$off"
) &
WATCHER=$!

# Ctrl-C reaches the whole foreground process group, so without this the script
# would die alongside the collector and skip the analysis and backup below.
# castr-collect ignores SIGINT itself and shuts down through a dispatch source,
# so inheriting the ignore costs it nothing.
trap '' INT
"$COLLECT" -o "$CSV" --despike --rate "$RATE" $TAGFLAG
trap - INT
kill "$WATCHER" 2>/dev/null

# A recorder that died badly leaves the terminal without echo.
stty sane 2>/dev/null

# ---------------------------------------------------------------- verify

if [ ! -s "$CSV" ]; then
    die "No file was written. The sensor never connected — check it's on and charged."
fi

rows=$(($(wc -l < "$CSV") - 1))
if [ "$rows" -lt 200 ]; then
    warn ""
    warn "Only $rows samples ($CSV). That's under a second of data — something went"
    warn "wrong. Keep the file, but don't count this as a session."
    exit 1
fi

# ---------------------------------------------------------------- analyse

head1 "Analysis"
"$ANALYZE" "$CSV"

# ---------------------------------------------------------------- notes

head1 "Notes"
say "${dim}Wind, anything odd, anything you'd want to know reading this back. Caster${off}"
say "${dim}and rod are recorded for you. None of it is in the CSV and none of it can${off}"
say "${dim}be recovered later. Enter to skip.${off}"
printf '> '
read -r note
if [ -n "$note" ]; then
    printf '%s  %-24s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$NAME" "$note" >> "$SESSIONS/sessions.log"
    say "${dim}Saved to $SESSIONS/sessions.log${off}"
fi

# ---------------------------------------------------------------- session sidecar
#
# Who cast and what they cast with, machine-readable, one file per recording.
#
# It is a sidecar because CSVFormat is byte-parity with WitMotion's export and
# does not get new columns — the same reason stroke tags live in
# <session>.events.csv.
#
# The rod's numbers are *copied* here rather than referenced by name. A rod file
# can be re-measured, a mount can move, and a pointer would then quietly rescale
# a recording made months earlier. What was true at capture time is what the
# session needs to keep.
# $NAME, not "$PERSON-$TEST": a second session of the same test on the same day
# gets a numeric suffix, and the sidecar has to follow the CSV it describes.
SIDECAR="$SESSIONS/$NAME.session.json"
num_or_null() { [ -n "${1:-}" ] && [ "$1" != null ] && printf '%s' "$1" || printf 'null'; }
str_or_null() { [ -n "${1:-}" ] && printf '"%s"' "$(json_escape "$1")" || printf 'null'; }

# The rod axis, copied from today's calibration. With it the sidecar carries
# everything the tip projection needs, so the analyser can draw a tip path from
# the session and this one file — no hunting through calibration/ for a pair of
# JSONs that look alike.
CAL_FILE="$CALIB/current-$PERSON.json"
AXIS_BODY=null; AXIS_ERR=null
if [ -e "$CAL_FILE" ]; then
    AXIS_BODY=$(json_array "$CAL_FILE" axisBody); AXIS_BODY=${AXIS_BODY:-null}
    AXIS_ERR=$(rod_field "$CAL_FILE" errorDeg); AXIS_ERR=${AXIS_ERR:-null}
    # An axis the calibration itself refused must not travel as though it were good.
    case "$(rod_field "$CAL_FILE" ok)" in false) AXIS_BODY=null; AXIS_ERR=null ;; esac
fi

cat > "$SIDECAR" <<EOF
{
  "session": "$NAME",
  "recorded": "$(date '+%Y-%m-%d %H:%M:%S')",
  "person": "$PERSON",
  "test": "$TEST",
  "rod": $(str_or_null "$ROD_NAME"),
  "rodLabel": $(str_or_null "$ROD_LABEL"),
  "rodLengthCm": $(num_or_null "$ROD_LENGTH_CM"),
  "sensorOffsetCm": $(num_or_null "$ROD_OFFSET_CM"),
  "tipFromSensorCm": $(num_or_null "$ROD_TIP_CM"),
  "rodAxisBody": $AXIS_BODY,
  "rodAxisErrorDeg": $AXIS_ERR,
  "calibration": $(str_or_null "$([ -e "$CALIB/current-$PERSON.json" ] && readlink "$CALIB/current-$PERSON.json")"),
  "note": $(str_or_null "$note"),
  "about": "Written by cast at the end of the recording. Geometry and rod axis are copied, not referenced, so re-measuring a rod or recalibrating later cannot rescale this session's tip path. Drop this file into the analyser alongside the CSV and the tip path draws itself."
}
EOF
say "${dim}$SIDECAR${off}"

# ---------------------------------------------------------------- backup

mkdir -p "$BACKUP"
cp "$CSV" "$BACKUP/" 2>/dev/null
[ -e "$EVENTS" ] && cp "$EVENTS" "$BACKUP/"

head1 "Done"
say "  ${green}$CSV${off}  ($rows samples)"
[ -e "$EVENTS" ] && say "  ${green}$EVENTS${off}  (stroke tags)"
say "  ${dim}backed up to $BACKUP${off}"
# A literal "<test>" placeholder reads badly, and reads worse when the person is
# called something like "test". Name the actual next session instead, following
# the order CAPTURE.md recommends.
case "$TEST" in
updown) NEXT=noline ;;
noline) NEXT=20ft ;;
20ft)   NEXT=fish ;;
*)      NEXT="" ;;
esac

say ""
if [ -n "$NEXT" ]; then
    say "  Next in the sequence:  ${bold}cast $PERSON $NEXT${off}"
else
    say "  ${dim}That completes the sequence for $PERSON.${off}"
fi
say "  ${dim}cast list  to see everything recorded so far${off}"
